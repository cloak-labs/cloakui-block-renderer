{
  "name": "@cloakui/block-renderer",
  "version": "0.4.0",
  "description": "A framework-agnostic rendering engine for JSON trees representing UI blocks.",
  "type": "module",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "build": "npm run build-ts",
    "build-ts": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist",
    "clean:modules": "rm -rf node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloak-labs/cloakui-block-renderer.git"
  },
  "author": "Kaelan Smith",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/cloak-labs/cloakui-block-renderer/issues"
  },
  "homepage": "https://github.com/cloak-labs/cloakui-block-renderer#readme",
  "dependencies": {
    "@kaelan/deep-merge-ts": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "ts-essentials": "^9.4.1",
    "typescript": "7.0.2",
    "oxfmt": "0.71.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
